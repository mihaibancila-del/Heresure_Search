SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_mailbox@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM=your_mailbox@gmail.com
MAIL_TO=your_mailbox@gmail.com

# --- Postgres ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGDATABASE=Agents_Heresure
PGPASSWORD=change_me
# [EN] path to psql if it's not in PATH (only needed for send_campaign.py/parser.py)
# [RU] путь к psql, если он не в PATH (нужен только для send_campaign.py/parser.py)
# PG_BIN=/usr/bin/psql

# --- [EN] Login (invite-only). REQUIRED — the app will not start without it ---
# SECRET_KEY signs the session cookie. Generate your own and keep it stable:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs every user out. There is no signup page: accounts are created
# by an admin on /admin/users, or with `python3 -m scripts.manage_users`.
# --- [RU] Вход (только по приглашению). ОБЯЗАТЕЛЬНО — без этого приложение не стартует ---
# SECRET_KEY подписывает cookie сессии. Сгенерируйте свой и не меняйте:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Его смена разлогинивает всех. Страницы регистрации нет: аккаунты создаёт админ
# на /admin/users или командой `python3 -m scripts.manage_users`.
SECRET_KEY=change_me_generate_a_real_random_value

# [EN] Set to true on the server (nginx terminates TLS). Leave false for local http,
# or the browser will refuse to send the session cookie and login will appear to fail.
# [RU] На сервере поставьте true (TLS терминирует nginx). Для локального http
# оставьте false, иначе браузер не отправит cookie сессии и вход будет "не работать".
SESSION_COOKIE_SECURE=false

# [EN] Optional. Defaults shown.
# [RU] Необязательные. Показаны значения по умолчанию.
# SESSION_LIFETIME_DAYS=14
# INVITE_TTL_HOURS=72
# PASSWORD_MIN_LENGTH=10

# --- [EN] App (used only for the local run `python3 wsgi.py`) ---
# --- [RU] App (используется только при локальном запуске `python3 wsgi.py`) ---
# APP_HOST=127.0.0.1
# APP_PORT=5000
